@model StockManagement.Entity.InvoiceMaster

@{
    ViewBag.Title = "Delete Invoice";
    var dmrList    = ViewBag.DmrList    as List<StockManagement.Entity.DailyMaterialInfo>    ?? new();
    var vendorList = ViewBag.VendorList as List<StockManagement.Core.Vendor> ?? new();
    var vendor     = vendorList.FirstOrDefault(v => v.VendorId == Model.VendorId);
    var dmr        = dmrList.FirstOrDefault(d => d.DmrId == Model.DmrId);
}

<h2>Delete Invoice</h2>
<p class="text-danger">Are you sure you want to delete this Invoice?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">Invoice ID</dt>
    <dd class="col-sm-9">@Model.InvoiceId</dd>

    <dt class="col-sm-3">DMR</dt>
    <dd class="col-sm-9">
        @if (dmr != null)
        { <span>DMR-@dmr.DmrId (@dmr.DeliveryDate.ToString("dd-MM-yyyy"))</span> }
        else
        { <span>DMR-@Model.DmrId</span> }
    </dd>

    <dt class="col-sm-3">Vendor</dt>
    <dd class="col-sm-9">@(vendor?.Name ?? Model.VendorId.ToString())</dd>

    <dt class="col-sm-3">Invoice Date</dt>
    <dd class="col-sm-9">@Model.InvoiceDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

@using (Html.BeginForm("Delete", "Invoice", new { id = Model.InvoiceId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index", "Invoice")" class="btn btn-secondary">Cancel</a>
}
