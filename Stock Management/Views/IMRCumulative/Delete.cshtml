@model StockManagement.Entity.IMIRCumulative

@{
    ViewBag.Title = "Delete IMIR Cumulative";
}

<h2>Delete IMIR Cumulative</h2>

<div class="alert alert-danger">Are you sure you want to delete this record?</div>
<div>
    <dl class="row">
        <dt class="col-sm-3">IMIR</dt>
        <dd class="col-sm-9">@Model.ImirId</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>

        <dt class="col-sm-3">Remarks</dt>
        <dd class="col-sm-9">@Model.Remarks</dd>
    </dl>
</div>

@using (Html.BeginForm("Delete", "IMRCumulative", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ImirCumulativeId)
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
}
