@model StockManagement.Entity.IMIRCumulative

@{
    ViewBag.Title = "Edit IMIR Cumulative";
    var imrList = ViewBag.ImrList as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<h2>Edit IMR Cumulative</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ImirCumulativeId)
    <div class="form-group">
        <label>IMR</label>
        @Html.DropDownListFor(m => m.ImirId, (IEnumerable<SelectListItem>)ViewBag.ImrList, "-- Select IMIR --", new { @class = "form-control" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.Quantity)
        @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", step = "0.01" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.Remarks)
        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control" })
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    </div>
}
