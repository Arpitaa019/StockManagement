@model StockManagement.Core.PurchaseOrderMaster

@{
    ViewBag.Title = "Edit Purchase Order";
    var uomOptions = new[] { "KG", "MTR", "PCS", "LTR", "NOS" };
    var statusList = new SelectList(new[] { "Draft", "Issued", "Closed", "Cancelled" }, Model.Status);
}

<h2>Edit Purchase Order</h2>

@using (Html.BeginForm("Edit", "PurchaseOrder", new { id = Model.POId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.POId)
    @Html.HiddenFor(m => m.CreatedDate)

    <div class="form-horizontal">
        <h4>Order Information</h4>
        <hr />

        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.PONumber)
                @Html.TextBoxFor(m => m.PONumber, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                <label>Purchase Request</label>
                <select name="PRId" class="form-control">
                    <option value="0">-- Select PR --</option>
                    @foreach (dynamic pr in ViewBag.PurchaseRequests)
                    {
                        if (Model.PRId == pr.PRId)
                        {
                            <option value="@pr.PRId" selected="selected">@pr.PRNumber</option>
                        }
                        else
                        {
                            <option value="@pr.PRId">@pr.PRNumber</option>
                        }
                    }
                </select>
                @Html.HiddenFor(m => m.PRNumber)
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Department)
                @Html.TextBoxFor(m => m.Department, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.VendorId)
                @Html.TextBoxFor(m => m.VendorId, new { @class = "form-control", type = "number" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.VendorName)
                @Html.TextBoxFor(m => m.VendorName, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Status)
                @Html.DropDownListFor(m => m.Status, statusList, "Select Status", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.OrderDate)
                @Html.TextBoxFor(m => m.OrderDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.DeliveryDate)
                @Html.TextBoxFor(m => m.DeliveryDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.TotalAmount)
                @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", type = "number", step = "0.01", id = "totalAmount", @readonly = "readonly" })
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks)
                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "2" })
            </div>
        </div>

        <h4 class="mt-4">Item Details</h4>
        <hr />

        <table class="table table-bordered" id="itemsTable">
            <thead class="table-light">
                <tr>
                    <th>Item Code No</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>UOM</th>
                    <th>Unit Price</th>
                    <th>Total Price</th>
                    <th><button type="button" class="btn btn-sm btn-success" onclick="addRow()">+ Add Row</button></th>
                </tr>
            </thead>
            <tbody id="itemsBody">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="Items[@i].PODetailId" value="@Model.Items[i].PODetailId" />
                            <input name="Items[@i].ItemCodeNo" class="form-control" value="@Model.Items[i].ItemCodeNo" />
                        </td>
                        <td><input name="Items[@i].Description" class="form-control" value="@Model.Items[i].Description" /></td>
                        <td><input name="Items[@i].Quantity" class="form-control qty-input" type="number" step="0.01" value="@Model.Items[i].Quantity" /></td>
                        <td>
                            <select name="Items[@i].UnitOfMeasure" class="form-control">
                                <option value="">Select UOM</option>
                                @foreach (var uom in uomOptions)
                                {
                                    if (Model.Items[i].UnitOfMeasure == uom)
                                    { <option value="@uom" selected="selected">@uom</option> }
                                    else
                                    { <option value="@uom">@uom</option> }
                                }
                            </select>
                        </td>
                        <td><input name="Items[@i].UnitPrice" class="form-control unit-price-input" type="number" step="0.01" value="@Model.Items[i].UnitPrice" /></td>
                        <td><input name="Items[@i].TotalPrice" class="form-control total-price-input" type="number" step="0.01" value="@Model.Items[i].TotalPrice" readonly /></td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-group mt-3">
            <input type="submit" value="Save Changes" class="btn btn-primary" />
            <a href="@Url.Action("Index", "PurchaseOrder")" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        function addRow() {
            const tbody = document.getElementById('itemsBody');
            const row = `<tr>
                <td>
                    <input type="hidden" name="Items[${rowIndex}].PODetailId" value="0" />
                    <input name="Items[${rowIndex}].ItemCodeNo" class="form-control" />
                </td>
                <td><input name="Items[${rowIndex}].Description" class="form-control" /></td>
                <td><input name="Items[${rowIndex}].Quantity" class="form-control qty-input" type="number" step="0.01" value="0" /></td>
                <td>
                    <select name="Items[${rowIndex}].UnitOfMeasure" class="form-control">
                        <option value="">Select UOM</option>
                        <option value="KG">KG</option>
                        <option value="MTR">MTR</option>
                        <option value="PCS">PCS</option>
                        <option value="LTR">LTR</option>
                        <option value="NOS">NOS</option>
                    </select>
                </td>
                <td><input name="Items[${rowIndex}].UnitPrice" class="form-control unit-price-input" type="number" step="0.01" value="0" /></td>
                <td><input name="Items[${rowIndex}].TotalPrice" class="form-control total-price-input" type="number" step="0.01" value="0" readonly /></td>
                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
            </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
            rowIndex++;
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            reindexRows();
            recalcGrandTotal();
        }

        function reindexRows() {
            const rows = document.querySelectorAll('#itemsBody tr');
            rows.forEach((row, i) => {
                row.querySelectorAll('input, select').forEach(el => {
                    if (el.name) el.name = el.name.replace(/Items\[\d+\]/, `Items[${i}]`);
                });
            });
            rowIndex = rows.length;
        }

        function recalcRowTotal(input) {
            const row = input.closest('tr');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const price = parseFloat(row.querySelector('.unit-price-input').value) || 0;
            row.querySelector('.total-price-input').value = (qty * price).toFixed(2);
            recalcGrandTotal();
        }

        function recalcGrandTotal() {
            let total = 0;
            document.querySelectorAll('.total-price-input').forEach(el => {
                total += parseFloat(el.value) || 0;
            });
            document.getElementById('totalAmount').value = total.toFixed(2);
        }

        document.addEventListener('input', e => {
            if (e.target.classList.contains('qty-input') || e.target.classList.contains('unit-price-input')) {
                recalcRowTotal(e.target);
            }
        });
    </script>
}
