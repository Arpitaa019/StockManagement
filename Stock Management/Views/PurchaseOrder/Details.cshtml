@model StockManagement.Core.PurchaseOrderMaster

@{
    ViewBag.Title = "Purchase Order Details";
}

<h2>Purchase Order Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">PO Number</dt>
    <dd class="col-sm-9">@Model.PONumber</dd>

    <dt class="col-sm-3">PR Number</dt>
    <dd class="col-sm-9">@Model.PRNumber</dd>

    <dt class="col-sm-3">Vendor</dt>
    <dd class="col-sm-9">@Model.VendorName</dd>

    <dt class="col-sm-3">Order Date</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Delivery Date</dt>
    <dd class="col-sm-9">@Model.DeliveryDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Status == "Issued" ? "bg-success" :
                              Model.Status == "Cancelled" ? "bg-danger" :
                              Model.Status == "Closed" ? "bg-secondary" : "bg-warning text-dark")">
            @Model.Status
        </span>
    </dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Remarks</dt>
    <dd class="col-sm-9">@Model.Remarks</dd>

    <dt class="col-sm-3">Created Date</dt>
    <dd class="col-sm-9">@Model.CreatedDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Modified Date</dt>
    <dd class="col-sm-9">@Model.ModifiedDate.ToString("dd-MM-yyyy")</dd>
</dl>

<h4 class="mt-4">Item Details</h4>
<hr />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Item Code No</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>UOM</th>
            <th>Unit Price</th>
            <th>Total Price</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model.Items[i].ItemCodeNo</td>
                <td>@Model.Items[i].Description</td>
                <td>@Model.Items[i].Quantity</td>
                <td>@Model.Items[i].UnitOfMeasure</td>
                <td>@Model.Items[i].UnitPrice.ToString("N2")</td>
                <td>@Model.Items[i].TotalPrice.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="6" class="text-end">Grand Total:</td>
            <td>@Model.TotalAmount.ToString("N2")</td>
        </tr>
    </tfoot>
</table>

<a href="@Url.Action("Edit", "PurchaseOrder", new { id = Model.POId })" class="btn btn-warning">Edit</a>
<a href="@Url.Action("Index", "PurchaseOrder")" class="btn btn-secondary">Back to List</a>
