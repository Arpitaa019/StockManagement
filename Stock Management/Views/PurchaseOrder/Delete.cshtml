@model StockManagement.Core.PurchaseOrderMaster

@{
    ViewBag.Title = "Delete Purchase Order";
}

<h2>Delete Purchase Order</h2>
<p class="text-danger">Are you sure you want to delete this Purchase Order and all its line items?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">PO Number</dt>
    <dd class="col-sm-9">@Model.PONumber</dd>

    <dt class="col-sm-3">PR Number</dt>
    <dd class="col-sm-9">@Model.PRNumber</dd>

    <dt class="col-sm-3">Vendor</dt>
    <dd class="col-sm-9">@Model.VendorName</dd>

    <dt class="col-sm-3">Order Date</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Delivery Date</dt>
    <dd class="col-sm-9">@Model.DeliveryDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Line Items</dt>
    <dd class="col-sm-9">@Model.Items.Count item(s)</dd>
</dl>

@using (Html.BeginForm("Delete", "PurchaseOrder", new { id = Model.POId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index", "PurchaseOrder")" class="btn btn-secondary">Cancel</a>
}
