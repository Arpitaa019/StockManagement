@model IEnumerable<StockManagement.Core.PurchaseOrderMaster>

@{
    ViewBag.Title = "Purchase Orders";
}

<h2>Purchase Orders</h2>
<p><a href="@Url.Action("Create", "PurchaseOrder")" class="btn btn-primary">+ New Purchase Order</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>PO Number</th>
            <th>PR Number</th>
            <th>Vendor</th>
            <th>Order Date</th>
            <th>Delivery Date</th>
            <th>Department</th>
            <th>Status</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var po in Model)
        {
            <tr>
                <td>@po.POId</td>
                <td>@po.PONumber</td>
                <td>@po.PRNumber</td>
                <td>@po.VendorName</td>
                <td>@po.OrderDate.ToString("dd-MM-yyyy")</td>
                <td>@po.DeliveryDate.ToString("dd-MM-yyyy")</td>
                <td>@po.Department</td>
                <td>
                    <span class="badge @(po.Status == "Issued" ? "bg-success" :
                                         po.Status == "Cancelled" ? "bg-danger" :
                                         po.Status == "Closed" ? "bg-secondary" : "bg-warning text-dark")">
                        @po.Status
                    </span>
                </td>
                <td>@po.TotalAmount.ToString("N2")</td>
                <td>
                    <a href="@Url.Action("Details", "PurchaseOrder", new { id = po.POId })" class="btn btn-sm btn-info">Details</a>
                    <a href="@Url.Action("Edit", "PurchaseOrder", new { id = po.POId })" class="btn btn-sm btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", "PurchaseOrder", new { id = po.POId })" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
