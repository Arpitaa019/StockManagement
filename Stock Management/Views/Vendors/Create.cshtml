@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model StockManagement.Core.Vendor

@{
    ViewBag.Title = "Create Vendor";
}

<h2>Create Vendor</h2>

@using (Html.BeginForm("Create", "Vendor", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Vendor</h4>
        <hr />

        <!-- Row 1 -->
        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Contact)
                @Html.TextBoxFor(m => m.Contact, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Address)
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
            </div>
        </div>

        <!-- Row 2 -->
        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.GSTNumber)
                @Html.TextBoxFor(m => m.GSTNumber, new { @class = "form-control" })
            </div>
        </div>

        <!-- Row 3 -->
        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.PANNumber)
                @Html.TextBoxFor(m => m.PANNumber, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.BankAccount)
                @Html.TextBoxFor(m => m.BankAccount, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.IFSCCode)
                @Html.TextBoxFor(m => m.IFSCCode, new { @class = "form-control" })
            </div>
        </div>

        <!-- Row 4 -->
        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.Country)
                @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.State)
                @Html.TextBoxFor(m => m.State, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.City)
                @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
            </div>
        </div>

        <!-- Row 5 -->
        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.PostalCode)
                @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.VendorType)
                @Html.DropDownListFor(m => m.VendorType,
                         new SelectList(new[] { "Manufacturer", "Supplier", "Contractor" }),
                         "Select Type",
                         new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.IsActive)
                @Html.CheckBoxFor(m => m.IsActive)
            </div>
        </div>

        <!-- Row 6 -->
        <div class="form-group row">
            <div class="col-md-6">
                @Html.LabelFor(m => m.CreatedDate)
                @Html.TextBoxFor(m => m.CreatedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.ModifiedDate)
                @Html.TextBoxFor(m => m.ModifiedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
        </div>

        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary" />
        </div>
    </div>
}
