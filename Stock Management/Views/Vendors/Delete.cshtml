@model StockManagement.Core.Vendor

@{
    ViewBag.Title = "Delete Vendor";
}

<h2>Delete Vendor</h2>
<p class="text-danger">Are you sure you want to delete this vendor?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Vendor Type</dt>
    <dd class="col-sm-9">@Model.VendorType</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>

@using (Html.BeginForm("Delete", "Vendors", new { id = Model.VendorId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index", "Vendors")" class="btn btn-secondary">Cancel</a>
}
