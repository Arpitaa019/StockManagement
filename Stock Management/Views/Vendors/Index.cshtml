@model IEnumerable<StockManagement.Core.Vendor>

@{
    ViewBag.Title = "Vendors";
}

<h2>Vendors</h2>
<p><a href="@Url.Action("Create", "Vendors")" class="btn btn-primary">+ Add Vendor</a></p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Contact</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Vendor Type</th>
            <th>GST Number</th>
            <th>City</th>
            <th>State</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.VendorId</td>
                <td>@v.Name</td>
                <td>@v.Contact</td>
                <td>@v.Email</td>
                <td>@v.Phone</td>
                <td>@v.VendorType</td>
                <td>@v.GSTNumber</td>
                <td>@v.City</td>
                <td>@v.State</td>
                <td>@(v.IsActive ? "Yes" : "No")</td>
                <td>
                    <a href="@Url.Action("Details", "Vendors", new { id = v.VendorId })" class="btn btn-sm btn-info">Details</a>
                    <a href="@Url.Action("Edit", "Vendors", new { id = v.VendorId })" class="btn btn-sm btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", "Vendors", new { id = v.VendorId })" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
