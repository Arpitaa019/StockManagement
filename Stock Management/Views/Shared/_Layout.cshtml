<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stock_Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Stock_Management.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Stock_Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="prDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Purchase Request</a>
                            <ul class="dropdown-menu" aria-labelledby="prDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index","PurchaseRequest")">Index</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseRequest','Details');return false;">Details</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseRequest','Edit');return false;">Edit</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseRequest','Delete');return false;">Delete</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="poDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Purchase Order</a>
                            <ul class="dropdown-menu" aria-labelledby="poDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index","PurchaseOrder")">Index</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseOrder','Details');return false;">Details</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseOrder','Edit');return false;">Edit</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('PurchaseOrder','Delete');return false;">Delete</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="invoiceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Invoice</a>
                            <ul class="dropdown-menu" aria-labelledby="invoiceDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index","Invoice")">Index</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('Invoice','Details');return false;">Details</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('Invoice','Edit');return false;">Edit</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('Invoice','Delete');return false;">Delete</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="dmrDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">DMR</a>
                            <ul class="dropdown-menu" aria-labelledby="dmrDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index","DMR")">Index</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('DMR','Details');return false;">Details</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('DMR','Edit');return false;">Edit</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('DMR','Delete');return false;">Delete</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="imirDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">IMIR</a>
                            <ul class="dropdown-menu" aria-labelledby="imirDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Index","IMRCumulative")">Index</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('IMRCumulative','Details');return false;">Details</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('IMRCumulative','Edit');return false;">Edit</a></li>
                                <li><a class="dropdown-item" href="#" onclick="promptIdAndNavigate('IMRCumulative','Delete');return false;">Delete</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Stock_Management - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function promptIdAndNavigate(controller, action) {
            var id = prompt('Enter id for ' + controller + ' ' + action + ':');
            if (!id) return;
            id = id.trim();
            if (!id) return;
            // basic validation: numeric
            if (!/^[0-9]+$/.test(id)) {
                alert('Please enter a numeric id');
                return;
            }
            var url = '/' + controller + '/' + action + '/' + id;
            window.location.href = url;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
