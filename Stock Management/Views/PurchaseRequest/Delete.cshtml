@model StockManagement.Core.PurchaseRequestMaster

@{
    ViewBag.Title = "Delete Purchase Request";
}

<h2>Delete Purchase Request</h2>
<p class="text-danger">Are you sure you want to delete this Purchase Request and all its line items?</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">PR Number</dt>
    <dd class="col-sm-9">@Model.PRNumber</dd>

    <dt class="col-sm-3">Request Date</dt>
    <dd class="col-sm-9">@Model.RequestDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Requested By</dt>
    <dd class="col-sm-9">@Model.RequestedBy</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Line Items</dt>
    <dd class="col-sm-9">@Model.Items.Count item(s)</dd>
</dl>

@using (Html.BeginForm("Delete", "PurchaseRequest", new { id = Model.PRId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index", "PurchaseRequest")" class="btn btn-secondary">Cancel</a>
}
