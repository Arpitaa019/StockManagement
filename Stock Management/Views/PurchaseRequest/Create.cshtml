@model StockManagement.Core.PurchaseRequestMaster

@{
    ViewBag.Title = "Create Purchase Request";
    var uomList = new SelectList(new[] { "KG", "MTR", "PCS", "LTR", "NOS" });
    var statusList = new SelectList(new[] { "Pending", "Approved", "Rejected", "In Progress" });
}

<h2>Create Purchase Request</h2>

@using (Html.BeginForm("Create", "PurchaseRequest", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Master Information</h4>
        <hr />

        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.PRNumber)
                @Html.TextBoxFor(m => m.PRNumber, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.RequestDate)
                @Html.TextBoxFor(m => m.RequestDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.RequestedBy)
                @Html.TextBoxFor(m => m.RequestedBy, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.Department)
                @Html.TextBoxFor(m => m.Department, new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.Status)
                @Html.DropDownListFor(m => m.Status, statusList, "Select Status", new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(m => m.TotalAmount)
                @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", type = "number", step = "0.01", id = "totalAmount", @readonly = "readonly" })
            </div>
        </div>

        <div class="form-group row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks)
                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "2" })
            </div>
        </div>

        <h4 class="mt-4">Item Details</h4>
        <hr />

        <table class="table table-bordered" id="itemsTable">
            <thead class="table-light">
                <tr>
                    <th>Item Code No</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit of Measure</th>
                    <th><button type="button" class="btn btn-sm btn-success" onclick="addRow()">+ Add Row</button></th>
                </tr>
            </thead>
            <tbody id="itemsBody">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <select name="Items[@i].ItemCodeNo" class="form-control itemcode-select">
                                <option value="">-- Select Item --</option>
                                @{
                                    var sapcodes = (IEnumerable<StockManagement.Core.Sapcode>)ViewBag.Sapcodes ?? Enumerable.Empty<StockManagement.Core.Sapcode>();
                                    foreach(var s in sapcodes)
                                    {
                                        if (s.ItemCodeNo == Model.Items[i].ItemCodeNo)
                                        {
                                            <option value="@s.ItemCodeNo" data-desc="@System.Net.WebUtility.HtmlEncode(s.Material)" selected="selected">@System.Net.WebUtility.HtmlEncode(s.ItemCodeNo + " - " + s.Material)</option>
                                        }
                                        else
                                        {
                                            <option value="@s.ItemCodeNo" data-desc="@System.Net.WebUtility.HtmlEncode(s.Material)">@System.Net.WebUtility.HtmlEncode(s.ItemCodeNo + " - " + s.Material)</option>
                                        }
                                    }
                                }
                            </select>
                        </td>
                        <td><input name="Items[@i].Description" class="form-control desc-input" value="@Model.Items[i].Description" /></td>
                        <td><input name="Items[@i].Quantity" class="form-control qty-input" type="number" step="0.01" value="@Model.Items[i].Quantity" /></td>
                        <td>
                            <select name="Items[@i].UnitOfMeasure" class="form-control">
                                <option value="">Select UOM</option>
                                @foreach (var uom in new[] { "KG", "MTR", "PCS", "LTR", "NOS" })
                                {
                                    if (Model.Items[i].UnitOfMeasure == uom)
                                    {
                                        <option value="@uom" selected="selected">@uom</option>
                                    }
                                    else
                                    {
                                        <option value="@uom">@uom</option>
                                    }
                                }
                            </select>
                        </td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <template id="itemRowTemplate">
            <tr>
                <td>
                    <select name="__ITEMNAME__" class="form-control itemcode-select">
                        <option value="">-- Select Item --</option>
                        @{
                            var sapcodes2 = (IEnumerable<StockManagement.Core.Sapcode>)ViewBag.Sapcodes ?? Enumerable.Empty<StockManagement.Core.Sapcode>();
                            foreach(var s in sapcodes2)
                            {
                                <text><option value="@s.ItemCodeNo" data-desc="@System.Net.WebUtility.HtmlEncode(s.Material)">@System.Net.WebUtility.HtmlEncode(s.ItemCodeNo + " - " + s.Material)</option></text>
                            }
                        }
                    </select>
                </td>
                <td><input name="__DESCNAME__" class="form-control desc-input" /></td>
                <td><input name="__QTYNAME__" class="form-control qty-input" type="number" step="0.01" value="0" /></td>
                <td>
                    <select name="__UOMNAME__" class="form-control">
                        <option value="">Select UOM</option>
                        <option value="KG">KG</option>
                        <option value="MTR">MTR</option>
                        <option value="PCS">PCS</option>
                        <option value="LTR">LTR</option>
                        <option value="NOS">NOS</option>
                    </select>
                </td>
                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
            </tr>
        </template>

        <div class="form-group mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a href="@Url.Action("Index", "PurchaseRequest")" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        function addRow() {
            const tbody = document.getElementById('itemsBody');
            const template = document.getElementById('itemRowTemplate');
            const clone = template.content.cloneNode(true);
            tbody.appendChild(clone);
            reindexRows();
            rowIndex = document.querySelectorAll('#itemsBody tr').length;
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            reindexRows();
            recalcTotal();
        }

        function reindexRows() {
            const rows = document.querySelectorAll('#itemsBody tr');
            rows.forEach((row, i) => {
                // inputs/selects with placeholders
                row.querySelectorAll('input, select').forEach(el => {
                    if (el.name) {
                        el.name = el.name.replace(/Items\[\d+\]/, `Items[${i}]`)
                                  .replace('__ITEMNAME__', `Items[${i}].ItemCodeNo`)
                                  .replace('__DESCNAME__', `Items[${i}].Description`)
                                  .replace('__QTYNAME__', `Items[${i}].Quantity`)
                                  .replace('__UOMNAME__', `Items[${i}].UnitOfMeasure`);
                    } else {
                        // for template cloned elements, set names
                        if (el.getAttribute('name') === null) return;
                    }
                });
            });
            rowIndex = rows.length;
        }

        function recalcTotal() {
            let total = 0;
            document.querySelectorAll('.qty-input').forEach(el => {
                total += parseFloat(el.value) || 0;
            });
            document.getElementById('totalAmount').value = total.toFixed(2);
        }

        document.addEventListener('input', e => {
            if (e.target.classList.contains('qty-input')) recalcTotal();
        });

        // When item code select changes, populate description
        document.addEventListener('change', e => {
            if (e.target.classList.contains('itemcode-select')) {
                const sel = e.target;
                const desc = sel.selectedOptions[0]?.dataset?.desc || '';
                const row = sel.closest('tr');
                const descInput = row.querySelector('.desc-input');
                if (descInput) descInput.value = desc;
            }
        });
    </script>
}
