@model StockManagement.Core.PurchaseRequestMaster

@{
    ViewBag.Title = "Purchase Request Details";
}

<h2>Purchase Request Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">PR Number</dt>
    <dd class="col-sm-9">@Model.PRNumber</dd>

    <dt class="col-sm-3">Request Date</dt>
    <dd class="col-sm-9">@Model.RequestDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Requested By</dt>
    <dd class="col-sm-9">@Model.RequestedBy</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Status == "Approved" ? "bg-success" :
                              Model.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
            @Model.Status
        </span>
    </dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Remarks</dt>
    <dd class="col-sm-9">@Model.Remarks</dd>

    <dt class="col-sm-3">Created Date</dt>
    <dd class="col-sm-9">@Model.CreatedDate.ToString("dd-MM-yyyy")</dd>

    <dt class="col-sm-3">Modified Date</dt>
    <dd class="col-sm-9">@Model.ModifiedDate.ToString("dd-MM-yyyy")</dd>
</dl>

<h4 class="mt-4">Item Details</h4>
<hr />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Item Code No</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>Unit of Measure</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model.Items[i].ItemCodeNo</td>
                <td>@Model.Items[i].Description</td>
                <td>@Model.Items[i].Quantity</td>
                <td>@Model.Items[i].UnitOfMeasure</td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Edit", "PurchaseRequest", new { id = Model.PRId })" class="btn btn-warning">Edit</a>
<a href="@Url.Action("Index", "PurchaseRequest")" class="btn btn-secondary">Back to List</a>
