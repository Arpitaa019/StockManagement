@model StockManagement.Entity.DMRMaster

@{
    ViewBag.Title = "Edit DMR";
}

<h2>Edit DMR</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.DmrId)
    <div class="form-group">
        <label>Purchase Order</label>
        @Html.DropDownListFor(m => m.POId, (IEnumerable<SelectListItem>)ViewBag.POList, "-- Select PO --", new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.VendorId)
        @Html.TextBoxFor(m => m.VendorId, new { @class = "form-control", type = "number" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.DeliveryDate)
        @Html.TextBoxFor(m => m.DeliveryDate, new { @class = "form-control", type = "date" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.ApprovedBy)
        @Html.TextBoxFor(m => m.ApprovedBy, new { @class = "form-control" })
    </div>
    <div class="form-group mt-2 form-check">
        @Html.CheckBoxFor(m => m.IsFinalized, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.IsFinalized, new { @class = "form-check-label" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.FinalizedDate)
        @Html.TextBoxFor(m => m.FinalizedDate, new { @class = "form-control", type = "date" })
    </div>
    <div class="form-group mt-2">
        @Html.LabelFor(m => m.Remarks)
        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control" })
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    </div>
}
